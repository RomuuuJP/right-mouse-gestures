{
  "manifest_version": 3,
  "name": "Right Mouse Gestures",
  "version": "1.1.0",
  "description": "Use right-button mouse gestures to navigate, scroll, refresh, close, and switch tabs.",
  "permissions": ["tabs", "storage"],
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["overlay.css"],
    "run_at": "document_start",
    "all_frames": true
  }],
  "action": {"default_title": "Right Mouse Gestures"}
}
